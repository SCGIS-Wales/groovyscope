{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SCGIS-Wales/groovyscope/config-schema.json",
  "title": "groovyscope configuration (.groovyscope.yaml)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "groovy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)*$"
        },
        "compat": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)*$"
          }
        }
      }
    },
    "jdk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "home": {
          "type": [
            "string",
            "null"
          ]
        },
        "minimum": {
          "type": "integer",
          "minimum": 17
        },
        "autoProvision": {
          "type": "boolean"
        },
        "vendor": {
          "enum": [
            "temurin",
            "corretto"
          ]
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceRoots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "classpath": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "classpathFrom": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gradleTask": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "description": "Deprecated and ignored; run `groovyscope classpath` instead."
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trust": {
          "type": "boolean"
        },
        "sourceSets": {
          "type": "boolean"
        },
        "javaSources": {
          "type": "boolean"
        },
        "maxFileBytes": {
          "type": "integer",
          "minimum": 0
        },
        "classpathFile": {
          "type": [
            "string",
            "null"
          ],
          "description": "File listing classpath entries, one per line (written by `groovyscope classpath`)."
        },
        "maxFiles": {
          "type": "integer",
          "minimum": 0
        },
        "maxTotalBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "daemon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "idleTimeoutMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "heap": {
          "type": "string",
          "pattern": "^[0-9]+[kKmMgG]$"
        },
        "cds": {
          "type": "boolean"
        },
        "workerThreads": {
          "type": "integer",
          "minimum": 0
        },
        "requestQueue": {
          "type": "integer",
          "minimum": 1
        },
        "workspaceIdleMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "heapPressurePercent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "maxHeap": {
          "type": "string",
          "pattern": "^(auto|[0-9]+[kKmMgG])$"
        },
        "heapGrowthFactor": {
          "type": "number",
          "minimum": 1
        },
        "maxRestartsPerTenMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "heapDumpOnOutOfMemory": {
          "type": "boolean"
        },
        "logMaxBytes": {
          "type": "integer",
          "minimum": 0
        },
        "logsKept": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "lint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ruleset": {
          "type": [
            "string",
            "null"
          ]
        },
        "jenkinsRuleset": {
          "type": [
            "string",
            "null"
          ]
        },
        "failOnPriority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "publish": {
          "type": "boolean"
        },
        "publishMaxPriority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "rules": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "const": "off"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "priority"
                ],
                "properties": {
                  "priority": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                  }
                }
              }
            ]
          }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "push": {
          "type": "string",
          "enum": [
            "open",
            "workspace",
            "none"
          ]
        },
        "debounceMillis": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "typecheck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nullChecker": {
          "type": "string",
          "enum": [
            "off",
            "lenient",
            "strict"
          ]
        },
        "sqlInjection": {
          "type": "boolean"
        },
        "purity": {
          "type": "boolean"
        },
        "regex": {
          "type": "boolean"
        },
        "formatString": {
          "type": "boolean"
        },
        "combiner": {
          "type": "boolean"
        }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "afterWrite": {
          "type": "boolean"
        },
        "afterWriteInclude": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "compile",
              "lint",
              "practices",
              "typecheck"
            ]
          }
        },
        "afterWriteMaxFindings": {
          "type": "integer",
          "minimum": 1
        },
        "stopGate": {
          "type": "boolean"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "practices": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "severity": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(GS|RP)[0-9]{3}$"
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "info",
              "off"
            ]
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "discover": {
          "type": "boolean"
        }
      }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {
          "type": "string",
          "enum": [
            "basic",
            "greclipse"
          ]
        },
        "indentSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "maxBlankLines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "removeSemicolons": {
          "type": "boolean"
        },
        "properties": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxResults": {
          "type": "integer",
          "minimum": 1
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 256
        },
        "maxMessageChars": {
          "type": "integer",
          "minimum": 0
        },
        "structured": {
          "type": "boolean"
        }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warning",
            "error"
          ]
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "duplicates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minLines": {
          "type": "integer",
          "minimum": 2
        },
        "minStatements": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "diagram": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sharedHelperCallers": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runTasks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_:-]*$"
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 10
        }
      }
    },
    "reports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sarif": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "SARIF logs merged into check and review (SpotBugs and other tools); empty = the build's usual SpotBugs output when present."
        },
        "jacoco": {
          "type": [
            "string",
            "null"
          ],
          "description": "JaCoCo XML report read by coverage_gaps."
        }
      }
    },
    "naming": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowedAbbreviations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vocabulary": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestTimeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxInFlight": {
          "type": "integer",
          "minimum": 1
        },
        "confirmWrites": {
          "enum": [
            "auto",
            "never"
          ]
        },
        "progressSeconds": {
          "type": "number",
          "minimum": 0.5
        }
      }
    }
  }
}
