{
  "name": "groovy",
  "description": "Groovy 5/6 engineer that navigates code through LSP and groovyscope tools instead of text search",
  "tools": [
    "*"
  ],
  "allowedTools": [
    "read",
    "grep",
    "glob",
    "code",
    "@groovyscope/find_symbol",
    "@groovyscope/goto_definition",
    "@groovyscope/type_definition",
    "@groovyscope/find_references",
    "@groovyscope/hover",
    "@groovyscope/document_symbols",
    "@groovyscope/call_graph",
    "@groovyscope/impact_of",
    "@groovyscope/check",
    "@groovyscope/review",
    "@groovyscope/explain",
    "@groovyscope/profile_status",
    "@groovyscope/find_dynamic_code",
    "@groovyscope/workspace_status",
    "@groovyscope/read_symbol",
    "@groovyscope/find_code",
    "@groovyscope/find_duplicates",
    "@groovyscope/workspace_overview",
    "@groovyscope/review_changes",
    "@groovyscope/coverage_gaps",
    "@groovyscope/explain_code",
    "@groovyscope/check_naming"
  ],
  "toolsSettings": {
    "shell": {
      "allowedCommands": [
        "\\./gradlew .*",
        "groovyscope .*",
        "git status",
        "git diff.*"
      ]
    }
  },
  "includeMcpJson": true,
  "resources": [
    "file://.kiro/steering/**/*.md",
    "file://AGENTS.md"
  ],
  "hooks": {
    "agentSpawn": [
      {
        "command": "groovyscope checkup --agent"
      }
    ]
  },
  "welcomeMessage": "Groovy agent ready: LSP + groovyscope (27 tools). Try: review this branch as a merge request reviewer; review my changes; full quality check; find duplicated code; find swallowed exceptions; what breaks if I change <symbol>; explain what <Class> does; draw the class graph; check naming; explain <code>. A groovyscope checkup ran at start; I will say what it found."
}
