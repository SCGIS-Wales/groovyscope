{
  "name": "groovy",
  "description": "Groovy 5/6 engineer that navigates code through LSP and groovyscope tools instead of text search",
  "tools": [
    "*"
  ],
  "allowedTools": [
    "read",
    "grep",
    "glob",
    "code",
    "@groovyscope/find_symbol",
    "@groovyscope/goto_definition",
    "@groovyscope/type_definition",
    "@groovyscope/find_references",
    "@groovyscope/hover",
    "@groovyscope/document_symbols",
    "@groovyscope/call_graph",
    "@groovyscope/impact_of",
    "@groovyscope/check",
    "@groovyscope/review",
    "@groovyscope/explain",
    "@groovyscope/profile_status",
    "@groovyscope/find_dynamic_code",
    "@groovyscope/find_unused",
    "@groovyscope/workspace_status",
    "@groovyscope/suggest_reuse",
    "@groovyscope/read_symbol",
    "@groovyscope/find_code",
    "@groovyscope/find_duplicates",
    "@groovyscope/workspace_overview",
    "@groovyscope/review_changes",
    "@groovyscope/coverage_gaps",
    "@groovyscope/explain_code",
    "@groovyscope/check_naming",
    "@groovyscope/symbol_context",
    "@groovyscope/test_results",
    "@groovyscope/merge_conflicts",
    "@groovyscope/merge_review"
  ],
  "toolsSettings": {
    "shell": {
      "allowedCommands": [
        "groovyscope check(?: (?:--profile [A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*|--include [A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*|--json|--format (?:text|json|short|sarif)|--import-sarif [A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*|[A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*))*",
        "groovyscope review(?: (?:--changed|--base [A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*|--staged|--top [A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*|--json|[A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*))*",
        "groovyscope test-results(?: (?:--limit [A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*|--json|[A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*))*",
        "groovyscope unused(?: (?:--changed|--base [A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*|--json|[A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*))*",
        "groovyscope explain(?: (?:--json|[A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*))*",
        "groovyscope explain-code(?: (?:--json|[A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*))*",
        "groovyscope naming(?: (?:--json|[A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*))*",
        "groovyscope coverage(?: (?:--json|[A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*))*",
        "groovyscope impact(?: (?:--change [A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*|--json|[A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*))*",
        "groovyscope callgraph(?: (?:--direction [A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*|--depth [A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*|--json|[A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*))*",
        "groovyscope graph --format (?:mermaid|json)(?: (?:--path [A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*|--kinds [A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*|--depth [A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*|--level [A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*|--max-nodes [A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*|[A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*))*",
        "groovyscope fix(?: (?:--code [A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*|--changed|--base [A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*|--json|[A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*))*",
        "groovyscope format(?: (?:--json|[A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*))*",
        "groovyscope checkup(?: (?:--agent|--json|[A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*))*",
        "groovyscope merge status(?: (?:--json|[A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*))*",
        "groovyscope merge show(?: (?:--hunk [A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*|--json|[A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*))*",
        "groovyscope merge review(?: (?:--json|[A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*))*",
        "groovyscope logs(?: (?:-n [A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*|--lines [A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*|-f|--follow|--kiro|[A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*))*",
        "groovyscope version",
        "groovyscope doctor",
        "groovyscope daemon status",
        "\\./gradlew (?:test|check|jacocoTestReport)(?: --(?:offline|continue|info|quiet|warn|stacktrace|rerun-tasks|console=plain))*",
        "git status",
        "git diff(?: (?:--stat|--name-only|--name-status|--cached|--staged|--no-color|--numstat|--shortstat|--|-U[0-9]+|--unified=[0-9]+|[A-Za-z0-9_@#%+=:,./][A-Za-z0-9_@#%+=:,./-]*))*"
      ]
    }
  },
  "includeMcpJson": true,
  "resources": [
    "file://.kiro/steering/**/*.md",
    "file://AGENTS.md"
  ],
  "hooks": {
    "agentSpawn": [
      {
        "command": "groovyscope checkup --agent"
      }
    ],
    "userPromptSubmit": [
      {
        "command": "groovyscope hook"
      }
    ],
    "preToolUse": [
      {
        "matcher": "write",
        "command": "groovyscope hook"
      }
    ],
    "postToolUse": [
      {
        "matcher": "write",
        "command": "groovyscope hook"
      }
    ],
    "stop": [
      {
        "command": "groovyscope hook"
      }
    ]
  },
  "welcomeMessage": "Groovy agent ready: LSP + groovyscope. Recipes: type / (terminal UI) or @ (classic chat) and pick a groovy- prompt. Try: review this branch as a merge request reviewer; review my changes; full quality check; find duplicated code; find swallowed exceptions; what breaks if I change <symbol>; explain what <Class> does; draw the class graph; check naming; explain <code>. A groovyscope checkup ran at start; I will say what it found."
}
